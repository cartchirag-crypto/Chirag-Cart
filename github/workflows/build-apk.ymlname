.github/workflows/build-apk.ymlname: Build CHIRAG CART APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install Bubblewrap
        run: npm install -g @bubblewrap/cli

      - name: Create Android project
        run: |
          mkdir chirag-cart
          cd chirag-cart
          bubblewrap init --manifest="https://chirag-cart-app.base44.app/manifest.json"

      - name: Build APK
        working-directory: chirag-cart
        env:
          BUBBLEWRAP_KEYSTORE_PASSWORD: ${{ secrets.BUBBLEWRAP_KEYSTORE_PASSWORD }}
          BUBBLEWRAP_KEY_PASSWORD: ${{ secrets.BUBBLEWRAP_KEY_PASSWORD }}
        run: bubblewrap build

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: CHIRAG-CART-APK
          path: chirag-cart/app-release-signed.apk
